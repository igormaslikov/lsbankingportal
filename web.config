<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <system.webServer>

    <!-- ═══════════════════════════════════════════════
         DEFAULT DOCUMENTS
         ═══════════════════════════════════════════════ -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- ═══════════════════════════════════════════════
         PHP HANDLER (FastCGI — registered at server level)
         Change the path below if PHP is installed elsewhere.
         ═══════════════════════════════════════════════ -->
    <handlers>
      <remove name="PHP_via_FastCGI" />
      <add name="PHP_via_FastCGI"
           path="*.php"
           verb="GET,HEAD,POST"
           modules="FastCgiModule"
           scriptProcessor="C:\PHP\php-cgi.exe"
           resourceType="File"
           requireAccess="Script" />
    </handlers>

    <!-- ═══════════════════════════════════════════════
         FILE UPLOAD / REQUEST SIZE LIMITS
         Matches PHP's upload_max_filesize / post_max_size.
         30 MB here — adjust to match php.ini.
         ═══════════════════════════════════════════════ -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="31457280" />
        <!-- Block direct browser access to the verification-code directory -->
        <hiddenSegments>
          <add segment="web_verification_code" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- ═══════════════════════════════════════════════
         STATIC FILE / DIRECTORY SETTINGS
         ═══════════════════════════════════════════════ -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json"  mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff"  mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <!-- ═══════════════════════════════════════════════
         CUSTOM ERRORS — PassThrough lets PHP output reach
         the browser. Change to Custom for production.
         ═══════════════════════════════════════════════ -->
    <httpErrors existingResponse="PassThrough" />

    <!-- ═══════════════════════════════════════════════
         SECURITY HEADERS
         ═══════════════════════════════════════════════ -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Frame-Options"        value="SAMEORIGIN" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-XSS-Protection"       value="1; mode=block" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!-- ═══════════════════════════════════════════════════
       LET'S ENCRYPT / ACME HTTP-01 CHALLENGE
       This <location> block completely overrides the parent
       settings for .well-known/acme-challenge so IIS serves
       the extensionless token files as plain text and does
       NOT apply authentication or the PHP handler to them.
       ═══════════════════════════════════════════════════ -->
  <location path=".well-known/acme-challenge" overrideMode="Allow">
    <system.webServer>

      <!-- Serve extensionless files (ACME tokens have no extension) -->
      <staticContent>
        <mimeMap fileExtension="."  mimeType="text/plain" />
        <mimeMap fileExtension=".." mimeType="text/plain" />
      </staticContent>

      <!-- Allow extensionless URLs through request filtering -->
      <security>
        <requestFiltering>
          <fileExtensions>
            <add fileExtension="." allowed="true" />
          </fileExtensions>
          <!-- Override parent hiddenSegments so .well-known itself isn't blocked -->
          <hiddenSegments>
            <clear />
          </hiddenSegments>
        </requestFiltering>
      </security>

      <!-- Use only the static file handler — no PHP -->
      <handlers>
        <clear />
        <add name="ACME_StaticFile"
             path="*"
             verb="GET,HEAD"
             modules="StaticFileModule"
             resourceType="Either"
             requireAccess="Read" />
      </handlers>

      <!-- No authentication — Let's Encrypt is an anonymous external caller -->
      <httpErrors existingResponse="PassThrough" />

    </system.webServer>
  </location>

</configuration>
